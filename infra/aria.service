[Unit]
Description=ARIA backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/aria-backend
EnvironmentFile=/home/deploy/aria-backend/.env
ExecStart=/home/deploy/aria-backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
